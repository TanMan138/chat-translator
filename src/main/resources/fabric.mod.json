{
	"schemaVersion": 1,
	"id": "chat-translator",
	"version": "${version}",
	"name": "Lingo",
	"description": "Reads foreign chat in English automatically and translates your replies back. Runs on your own machine with OPUS-MT/ONNX, or bring your own key for DeepL, Google, or Langbly, or point it at your own Ollama server.",
	"authors": [
		"Tanmay"
	],
	"contact": {
		"sources": "https://github.com/TanMan138/lingo"
	},
	"license": "MIT",
	"icon": "assets/chat-translator/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.tanman.chattranslator.ChatTranslator"
		],
		"client": [
			"com.tanman.chattranslator.client.ChatTranslatorClient"
		],
		"modmenu": [
			"com.tanman.chattranslator.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "chat-translator.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*",
		"yet_another_config_lib_v3": ">=3.9.1"
	}
}
